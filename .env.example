# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CV_SERVICE_URL: URL of the separately deployable Python FastAPI Computer Vision Service.
# Example for local Windows setup: http://localhost:8000
CV_SERVICE_URL="http://localhost:8000"

# CV_SERVICE_SHARED_SECRET: Optional shared bearer secret between Node.js server and Python CV Service.
CV_SERVICE_SHARED_SECRET=""

# VISIONGUARD_ADMIN_PASSCODE: Optional operator/admin passcode for protected administrative actions.
VISIONGUARD_ADMIN_PASSCODE=""

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed browser origins (defaults to same-origin / APP_URL).
CORS_ALLOWED_ORIGINS=""
